      "parameters": {
        "jsCode": "let raw = items[0].json.output || items[0].json.message || '[]';\n\n// Remove markdown code block wrapper like ```json ... ```\nraw = raw.replace(/```json|```/g, '').trim();\n\nconst details = JSON.parse(raw);\n\nreturn { details };\n\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1264,
        528
      ],
      "id": "27d91614-e87a-4113-8381-e5a5f831dee7",
