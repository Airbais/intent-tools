    {
      "parameters": {
        "jsCode": "const textContent = $input.first().json.filecontent;\nconst binaryData = Buffer.from(textContent, 'utf8');\n\nreturn {\n  json: {},\n  binary: {\n    data: {\n      data: binaryData,\n      mimeType: 'text/plain',\n      fileName: $('Clean JSON').first().json.details.label+'.md'\n    }\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2144,
        528
      ],
      "id": "f1cb0df8-f391-4d8a-a248-791fb74868e4",
      "name": "Create File"
