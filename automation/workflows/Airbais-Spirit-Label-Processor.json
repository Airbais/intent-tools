      "id": "672de665-f0b8-4c68-9505-0b77de71a66a",
      "name": "Read Image Content",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        736,
        528
      ],
      "executeOnce": false
    },
    {
      "parameters": {
        "jsCode": "// Input from the previous node\nconst stdout = $input.first().json.stdout;\n\n// Split by newlines and filter out empty strings\nconst files = stdout.trim().split('\\n').filter(file => file.length > 0);\n\n// Create structured output\nconst result = files.map((filepath, index) => {\n  const filename = filepath.split('/').pop(); // Get just the filename\n  return {\n    filepath: filepath,\n    filename: filename,\n    directory: filepath.substring(0, filepath.lastIndexOf('/'))\n  };\n});\n\nreturn result.map(item => ({ json: item }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        176,
        512
