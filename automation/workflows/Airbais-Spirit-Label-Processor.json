    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an expert in wine, bourbon, and whiskey. You're going to look at images of bottle labels and extract relevant data for a database. I want you to look for the following values from the labels:\n\nLabel: The name of the sprit\nMaker: The maker of the spirit\nCategory: Choose only between Bourbon or Wine\nType: The specific type of spirit\nProof: The proof of the spririt if it is not wine\nYear: The year if it is a wine\n\nYou will output these in a clean JSON structure with name value pairs for each. Here's are two examples:\n\n[\n    \"label\": \"Maker's Mark\",\n    \"maker\": \"Maker's Mark Distillery\",\n    \"category\": Bourbon,\n    \"type\": \"Kentucky Straight Bourbon Whiskey\",\n    \"proof\": 90\n]\n\nand\n\n[\n    \"label\": \"Conundrum\",\n    \"maker\": \"Caymus Vineyard\",\n    \"category\": Wine,\n    \"type\": \"Cabernet Sauvignon\",\n    \"year\": 2020\n]\n",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.9,
      "position": [
        928,
        528
      ],
      "id": "a28a9f2b-147b-4e79-af75-a625d0923094",
      "name": "Label Processor",
      "executeOnce": false
    },
    {
      "parameters": {
        "modelName": "models/gemini-2.0-flash-exp-image-generation",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        928,
        752
      ],
      "id": "e839f870-6487-4adb-8ad3-8f27bbe297c3",
      "name": "Google Gemini Chat Model",
      "credentials": {
